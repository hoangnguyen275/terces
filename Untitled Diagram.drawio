        </mxCell>
        <mxCell id="pwZP-FHSW7L6A7eNcid5-60" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 19px;&quot;&gt;Access Token&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="150" x="780" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="pwZP-FHSW7L6A7eNcid5-61" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;• Used to create a new access token&lt;br&gt;&lt;br/&gt;• Long expiration time&lt;br&gt;&lt;br/&gt;• Does not necessarily need to use JWT&lt;br&gt;&lt;br/&gt;• Stored in a cookie&lt;br&gt;&lt;br/&gt;• Stored in the database (Session)&lt;br&gt;&lt;br/&gt;• Sent through cookies&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="280" x="272.5" y="1940" as="geometry" />
        </mxCell>
        <mxCell id="pwZP-FHSW7L6A7eNcid5-62" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;• Used to authenticate the user&lt;br&gt;&lt;br&gt;• Short expiration time&lt;br&gt;&lt;br&gt;• Uses JWT&lt;br&gt;&lt;br&gt;• Stored in temporary memory&lt;br&gt;&lt;br&gt;• Not stored in the database&lt;br&gt;&lt;br&gt;• Sent through the Header (helps prevent CSRF)&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="280" x="715" y="1940" as="geometry" />
        </mxCell>
        <mxCell id="pwZP-FHSW7L6A7eNcid5-63" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
