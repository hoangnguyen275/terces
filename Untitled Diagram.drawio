          <mxGeometry height="30" width="60" x="1640" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="pwZP-FHSW7L6A7eNcid5-65" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Stores small amounts of data&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;The browser automatically sends cookies with matching requests&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;code&gt;HttpOnly&lt;/code&gt; cookies cannot be directly read by JavaScript&lt;/font&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;This helps reduce the risk of refresh-token theft through XSS&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Commonly used to store refresh tokens because they can be configured more securely&lt;/font&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="180" width="420" x="1455" y="1990" as="geometry" />
        </mxCell>
